{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.bracelet.main": {
			"initial_state": "equipping",
			"states": {
				"equipping": {
					"animations": [ "fps_equip" ],
					"transitions": [
						{ "idle": "query.life_time > 1.58" }
					]
				},
				"idle": {
					"animations": [ "fps_idle" ]
				}
			}
		}
	}
}