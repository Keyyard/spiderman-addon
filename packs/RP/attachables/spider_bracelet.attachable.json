{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "curio:spider_bracelet",
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/spider_bracelet_texture",
				"enchanted": "textures/misc/enchanted_actor_glint"
			},
			"geometry": {
				"default": "geometry.spider_bracelet"
			},
			"scripts": {
				"initialize": [
					"v.last_time = query.time_stamp;"
				],
				"animate": [
					{ "root": "context.is_first_person == 1.0" },
					{ "tps_idle": "!context.is_first_person == 1.0" }
				]
			},
			"animations": {
				"root": "controller.animation.bracelet.main",
				"fps_equip": "animation.braceletFPS.equip",
				"fps_idle": "animation.braceletFPS.idle",
				"tps_idle": "animation.braceletTPS.idle"
			},
			"render_controllers": [ "controller.render.default" ]
		}
	}
}